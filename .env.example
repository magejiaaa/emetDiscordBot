DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# Server ID where DM submissions should be posted.
SUBMISSION_GUILD_ID=your_target_server_id_here

# Optional. If set, deploy-commands updates guild commands quickly for testing.
# DM commands are always deployed globally so they can appear in bot DMs.
DEV_GUILD_ID=

# Required. On Railway, use the PostgreSQL service's private/internal URL.
DATABASE_URL=postgresql://user:password@host:port/database
